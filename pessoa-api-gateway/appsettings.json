{

  "ReverseProxy": {
    "Routes": {
      "write-route": {
        "ClusterId": "write-cluster",
        "Match": {
          "Path": "/{**catch-all}",
          "Methods": [ "POST", "PUT", "DELETE" ]
        }
      },

      "read-route": {
        "ClusterId": "read-cluster",
        "Match": {
          "Path": "/{**catch-all}",
          "Methods": [ "GET" ]
        }
      }
    },
    "Clusters": {
      "write-cluster": {
        "Destinations": {
          "dest1": {
            "Address": "http://localhost:5227/"
          }
        }
      },
      "read-cluster": {
        "Destinations": {
          "dest2": {
            "Address": "http://localhost:5273/"
          }
        }
      }
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
